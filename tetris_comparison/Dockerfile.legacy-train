FROM python:2.7.18-buster

# Use NoScope's required TensorFlow/Keras generation on CPU to avoid a CUDA dependency for training.
RUN pip install --no-cache-dir \
    numpy==1.16.6 scipy==1.2.3 protobuf==3.17.3 tensorflow==0.12.1 Keras==1.2.2 \
    pandas==0.24.2 h5py==2.10.0 scikit-learn==0.20.4 scikit-image==0.14.5 \
    matplotlib==2.2.5 opencv-python-headless==3.4.8.29 pathos==0.2.8

ENV PYTHONPATH=/noscope KERAS_BACKEND=tensorflow MPLBACKEND=Agg PYTHONUNBUFFERED=1
WORKDIR /noscope

FROM polyis-polyis AS certificates
FROM tensorflow/tensorflow:1.3.0-devel-gpu

COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Xenial's original APT has no HTTPS transport. Bootstrap it before reading the signed archive.
RUN curl -fsSLo /tmp/apt-transport-https.deb \
      https://archive.ubuntu.com/ubuntu/pool/main/a/apt/apt-transport-https_1.2.35_amd64.deb \
    && dpkg -i /tmp/apt-transport-https.deb \
    && printf '%s\n' \
      'deb https://archive.ubuntu.com/ubuntu/ xenial main universe' \
      'deb https://archive.ubuntu.com/ubuntu/ xenial-updates main universe' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=2 update \
    && apt-get install -y --no-install-recommends \
      cmake libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-transport-https.deb

RUN mkdir /tmp/opencv \
    && curl -fsSL https://codeload.github.com/opencv/opencv/tar.gz/refs/tags/3.2.0 \
      | tar --strip-components=1 -xz -C /tmp/opencv \
    && mkdir /tmp/opencv/build \
    && cd /tmp/opencv/build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF \
      -DBUILD_opencv_apps=OFF -DBUILD_opencv_python2=OFF -DBUILD_opencv_python3=OFF \
      -DWITH_FFMPEG=ON -DWITH_CUDA=OFF -DWITH_IPP=OFF -DWITH_GTK=OFF -DWITH_OPENCL=OFF \
    && make -j12 install \
    && ldconfig \
    && rm -rf /tmp/opencv
